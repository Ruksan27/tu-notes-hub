// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Package {
  FREE
  SEMESTER_PASS
  ELITE_AI
}

enum SystemType {
  SEMESTER
  YEARLY
}

enum NoteType {
  HANDWRITTEN
  SLIDES_PPT
  PDF_BOOK
  SHORT_NOTES
  PROJECT_WORK
  PROJECT
  GUIDE
  LAB_WORK
  SYLLABUS
}

enum ExamType {
  BOARD_EXAM
  INTERNAL_EXAM
  BACK_PAPER
}

model User {
  id                    String    @id @default(uuid())
  name                  String
  email                 String    @unique
  password              String
  role                  Role      @default(STUDENT)
  packageType           Package   @default(FREE)
  isEmailVerified       Boolean   @default(false)
  subscriptionExpiresAt DateTime?
  facultyId             String?
  semesterOrder         Int?      // which semester/year the student is in
  payments              Payment[]
  projectOrders         ProjectOrder[]
  sellerProfile         SellerProfile?
  projectsListed        ProjectItem[]
  projectReviews        ProjectReview[]
  cart                  Cart?
  createdAt             DateTime  @default(now())
}

model SellerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college     String?
  bio         String?  @db.LongText
  experience  String?
  skills      String?  @db.LongText // comma-separated or JSON
  profilePic  String?
  isVerified  Boolean  @default(false)
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  // Social Links
  github      String?
  linkedin    String?
  youtube     String?
  instagram   String?
  tiktok      String?
  
  createdAt   DateTime @default(now())
}

model VerificationOTP {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      String   // 'REGISTER' | 'FORGOT_PASSWORD'
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  transactionId String   @unique
  screenshotUrl String?
  amount        Int
  status        String   @default("PENDING") // PENDING | COMPLETED | FAILED
  packageBought Package
  createdAt     DateTime @default(now())
}

model Faculty {
  id         String     @id
  name       String
  slug       String     @unique
  icon       String?
  systemType SystemType @default(SEMESTER)
  semesters  Semester[]
  visible    Boolean    @default(false)
}

model Semester {
  id            String         @id @default(uuid())
  name          String
  order         Int            @default(1)
  facultyId     String
  faculty       Faculty        @relation(fields: [facultyId], references: [id])
  subjects      Subject[]
  solutionBooks SolutionBook[]
  visible       Boolean        @default(true)
  visibleNew    Boolean        @default(true)
  visibleOld    Boolean        @default(true)
}

model Subject {
  id            String       @id @default(uuid())
  title         String
  code          String
  semesterId    String
  semester      Semester     @relation(fields: [semesterId], references: [id])
  notes         Note[]
  pastPapers    PastPaper[]
  cheatsheets   Cheatsheet[]
  solutionBooks SolutionBook[]
  mcqs          MCQ[]
}

model Note {
  id            String   @id @default(uuid())
  title         String
  description   String?
  cloudinaryUrl String
  fileSize      String?
  extractedText String?  @db.LongText
  noteType      NoteType @default(PDF_BOOK)
  isPremium     Boolean  @default(false)
  author        String?
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
}

model PastPaper {
  id            String   @id @default(uuid())
  year          Int
  examType      ExamType @default(BOARD_EXAM)
  cloudinaryUrl String
  extractedText String?  @db.LongText
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  createdAt     DateTime @default(now())
}

model Cheatsheet {
  id        String   @id @default(uuid())
  title     String
  content   String?  @db.LongText
  files     Json?
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  createdAt DateTime @default(now())
}

model MCQ {
  id            String   @id @default(uuid())
  question      String   @db.Text
  options       Json     
  correctOption Int      
  explanation   String?  @db.Text
  year          Int?
  examCategory  String?
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model SolutionBook {
  id            String   @id @default(uuid())
  title         String
  description   String?  @db.Text
  cloudinaryUrl String
  fileSize      String?
  isPremium     Boolean  @default(false)
  author        String?
  semesterId    String
  semester      Semester @relation(fields: [semesterId], references: [id])
  subjectId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id])
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
}

model ProjectItem {
  id                 String         @id @default(uuid())
  title              String
  shortDescription   String?        @db.Text
  description        String         @db.LongText
  category           String?
  subcategory        String?
  projectType        String?
  
  // Section B
  projectObjective   String?        @db.LongText
  modules            String?        @db.LongText
  requirements       String?        @db.LongText
  installation       String?        @db.LongText
  limitations        String?        @db.LongText
  version            String?
  features           String?        @db.LongText
  
  // Section C
  technologies       String
  frontend           String?
  backend            String?
  dbType             String?
  framework          String?
  libraries          String?
  
  // Section H & I & J
  originalPrice      Int
  discountPercentage Int            @default(0)
  negotiable         Boolean        @default(false)
  license            String?
  salesType          String?
  
  // Section D
  thumbnailUrl       String?
  screenshot1        String?
  screenshot2        String?
  screenshot3        String?
  screenshot4        String?
  images             String?        @db.LongText // Legacy/other images
  
  // Section E
  demoUrl            String?
  demoLinks          String?        @db.LongText // Legacy
  youtubeUrl         String?
  tiktokUrl          String?
  instagramUrl       String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  
  // Section F
  sourceDriveLink    String?
  adminDriveLink     String?
  
  // Section G
  demoCredentials    String?        @db.LongText // JSON
  
  // Section K
  sellerDeclared     Boolean        @default(false)
  
  // Admin Review
  adminNote          String?        @db.Text
  
  rating             Float          @default(0)
  reviewCount        Int            @default(0)

  // Analytics & SEO metrics
  views              Int            @default(0)
  organicViews       Int            @default(0)
  searchClicks       Int            @default(0)

  status             String         @default("ACTIVE") // PENDING | ACTIVE | INACTIVE | REJECTED | CHANGES_REQUESTED
  createdAt          DateTime       @default(now())
  
  sellerId           String?
  user               User?          @relation(fields: [sellerId], references: [id])
  
  orders             ProjectOrder[]
  reviews            ProjectReview[]
  cartItems          CartItem[]
}

model ProjectOrder {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  projectItemId   String
  projectItem     ProjectItem @relation(fields: [projectItemId], references: [id])
  status          String      @default("PENDING") // PENDING | APPROVED | REJECTED | INQUIRY
  transactionId   String?     @unique
  screenshotUrl   String?
  amount          Int
  message         String?     @db.Text
  
  orderEmail         String?
  deliveryLink       String?
  buyerTermsAccepted Boolean        @default(false)
  
  createdAt       DateTime    @default(now())
}

model ProjectReview {
  id              String      @id @default(uuid())
  projectId       String
  projectItem     ProjectItem @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating          Int
  comment         String?     @db.Text
  createdAt       DateTime    @default(now())
}

model SiteSettings {
  id             String   @id @default("singleton")
  whatsappLink   String   @default("https://wa.me/9800000000")
  facebookLink   String   @default("https://facebook.com")
  tiktokLink     String   @default("https://tiktok.com")
  instagramLink  String   @default("https://instagram.com")
  contactPhone   String   @default("9767776999")
  contactEmail   String   @default("tunoteshub@gmail.com")
  paymentQrUrl   String?
  updatedAt      DateTime @updatedAt
}

model PricingPlan {
  id                 String    @id @default(uuid())
  packageType        Package   @unique
  emoji              String
  name               String
  tagline            String
  price              String
  originalPrice      String?
  priceNote          String
  validity           String?
  color              String
  gradient           String
  glow               String
  popular            Boolean   @default(false)
  audience           String
  features           Json
  cta                String
  ctaStyle           String
  discountEndsAt     DateTime?
  updatedAt          DateTime  @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id            String      @id @default(uuid())
  cartId        String
  cart          Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  projectItemId String
  projectItem   ProjectItem @relation(fields: [projectItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([cartId, projectItemId])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  avatar    String?
  content   String   @db.Text
  rating    Int      @default(5)
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
}

model Blog {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  thumbnailUrl String?
  content      String   @db.LongText // HTML content from Rich Text Editor
  excerpt      String?  @db.Text
  metaTitle    String?
  metaDesc     String?  @db.Text
  keywords     String?
  author       String   @default("TU Notes Hub")
  views        Int      @default(0)
  isPublished  Boolean  @default(true)
  fileUrl      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
